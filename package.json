{
  "name": "@agentbank/exit",
  "version": "0.1.0",
  "description": "Owner exit tool for Agent Bank accounts: withdraw everything from your Safe smart account with only an RPC URL and your owner key, without any Agent Bank service.",
  "license": "Apache-2.0",
  "author": "Agent Bank",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bank-of-an-agent/exit-tool.git"
  },
  "bugs": "https://github.com/bank-of-an-agent/exit-tool/security/advisories/new",
  "keywords": [
    "agent-bank",
    "safe",
    "erc-7579",
    "exit",
    "non-custodial",
    "usdc",
    "base"
  ],
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "agentbank-exit": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "web/index.html",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:web": "node scripts/build-web.mjs",
    "check:web": "node scripts/build-web.mjs --check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "sync-abis": "bash scripts/sync-abis.sh",
    "prepublishOnly": "pnpm run build",
    "drill:demo": "tsx scripts/drill-demo.ts"
  },
  "dependencies": {
    "viem": "2.57.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@safe-global/safe-contracts": "1.4.1",
    "@safe-global/safe-deployments": "^1.37.63",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
